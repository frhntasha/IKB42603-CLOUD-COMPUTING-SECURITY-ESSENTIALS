}</style><style data-inline-css="cb978f824">.space-outputs-markdown-preview{--text-base:.6rem;--text-h1:.75rem;--text-h2:.7rem;--text-h3:.65rem;--text-code:.5rem;--spacing-xs:2px;--spacing-sm:3px;--line-height:.8rem;font-size:var(--text-base);line-height:var(--line-height);gap:.25rem!important}.space-outputs-markdown-preview *{font-size:var(--text-base)!important;line-height:var(--line-height)!important}.space-outputs-markdown-preview h1{font-size:var(--text-h1)!important;margin:var(--spacing-sm) 0!important}.space-outputs-markdown-preview h2{font-size:var(--text-h2)!important;margin:var(--spacing-xs) 0!important}.space-outputs-markdown-preview h3{font-size:var(--text-h3)!important;margin:var(--spacing-xs) 0!important}.space-outputs-markdown-preview p{margin:var(--spacing-sm) 0!important}.space-outputs-markdown-preview code{font-size:var(--text-code)!important;border-radius:3px!important;height:10px!important;padding:0 2px!important}.space-outputs-markdown-preview code>span{border-radius:1.5px!important;width:6px!important;height:6px!important}.space-outputs-markdown-preview pre,.space-outputs-markdown-preview table{box-shadow:none!important;background:0 0!important}.space-outputs-markdown-preview hr{border-top:.5px solid!important;border-top-color:var(--cds-text-muted)!important}.space-outputs-markdown-preview a{pointer-events:none!important;cursor:default!important}.space-outputs-markdown-preview button{background:0 0!important;border:.5px solid!important;border-radius:8px!important;width:100%!important}.space-outputs-markdown-preview img{width:100%!important;max-width:100%!important;height:auto!important}</style><title>Membuat lab 1 - Claude</title><meta name="x-route-title" data-router-head="" data-intended-title="Claude"><style data-inline-css="cb0805531">@keyframes review-scroll-flash{0%{box-shadow:0 0 0 2px color-mix(in srgb, var(--cds-fill-accent) 55%, transparent), 0 0 16px 2px color-mix(in srgb, var(--cds-fill-accent) 25%, transparent)}to{box-shadow:0 0 #0000,0 0 #0000}}.review-scroll-flash{animation:.9s ease-out review-scroll-flash}</style><style data-image-preview-vt="">
::view-transition-group(chat-image-preview) {
  animation-duration: 350ms;
  /* CDS --cds-ease-snap */
  animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1);
}
html.vt-image-preview-closing::view-transition-group(chat-image-preview) {
  animation-duration: 250ms;
}
::view-transition-image-pair(chat-image-preview) {
  isolation: auto;
  overflow: clip;
  animation: vt-image-preview-decoration-in 350ms cubic-bezier(0.32, 0.72, 0, 1) both;
}
/* Separate close keyframes (not animation-direction: reverse) so the
   timing-function isn't time-reversed too — a reversed snap curve holds at
   full shadow then drops to zero in the last few frames, which reads as a
   jump. */
html.vt-image-preview-closing::view-transition-image-pair(chat-image-preview) {
  animation-name: vt-image-preview-decoration-out;
  animation-duration: 250ms;
}
/* Border-radius morphs between the source thumbnail's radius and the viewer's
   radius (both read from computed style at transition time and set on CSS
   custom properties) so there's no corner snap at either end. Shadow fades
   in/out alongside. */
@keyframes vt-image-preview-decoration-in {
  from {
    box-shadow: 0 4px 32px color-mix(in srgb, var(--cds-black) 0%, transparent), 0 0 0 0.5px color-mix(in srgb, var(--cds-black) 0%, transparent);
    border-radius: var(--vt-image-preview-source-radius, 0.5rem);
  }
  to {
    box-shadow: 0 4px 32px color-mix(in srgb, var(--cds-black) 30%, transparent), 0 0 0 0.5px color-mix(in srgb, var(--cds-black) 25%, transparent);
    border-radius: var(--vt-image-preview-target-radius, 0.375rem);
  }
}
@keyframes vt-image-preview-decoration-out {
  from {
    box-shadow: 0 4px 32px color-mix(in srgb, var(--cds-black) 30%, transparent), 0 0 0 0.5px color-mix(in srgb, var(--cds-black) 25%, transparent);
    border-radius: var(--vt-image-preview-target-radius, 0.375rem);
  }
  to {
    box-shadow: 0 4px 32px color-mix(in srgb, var(--cds-black) 0%, transparent), 0 0 0 0.5px color-mix(in srgb, var(--cds-black) 0%, transparent);
    border-radius: var(--vt-image-preview-source-radius, 0.5rem);
  }
}
::view-transition-old(chat-image-preview),
::view-transition-new(chat-image-preview) {
  animation: none;
  mix-blend-mode: normal;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* Direction-aware: on open show only NEW (full image revealing); on close show
   only OLD (full image cropping back). */
html:not(.vt-image-preview-closing)::view-transition-old(chat-image-preview) {
  display: none;
}
html.vt-image-preview-closing::view-transition-new(chat-image-preview) {
  display: none;
}
/* Thumbnail off-screen on close: no destination to morph to, so fade the
   group in place instead of freezing. (Don't touch transform — the group's
   transform is its absolute position; overriding it would fling the image
   toward (0,0).) */
html.vt-image-preview-no-origin::view-transition-group(chat-image-preview) {
  animation-name: vt-image-preview-fade-out;
}
@keyframes vt-image-preview-fade-out {
  to { opacity: 0; }
}
</style><style type="text/css">
